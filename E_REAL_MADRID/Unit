public abstract class Unit{
    
    private int id;
    private String name;
    
    public Unit(int id, String name) {
        this.id = id;
        this.name = name;
    }
    
    public int getId() {
        return this.id;
    }
    
    public String getName() {
        return this.name;
    }
    
    @Override
    public String toString() {
        return String.format("#%d - %s", this.id, this.name);
    }
    
    public abstract int getTrainingHours();
}

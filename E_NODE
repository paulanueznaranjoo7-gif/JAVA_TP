

import java.util.ArrayList;
import java.util.List;
import java.util.Collection;
import java.util.Comparator;

public class Directory extends Node {

    private List<Node> nodelist = new ArrayList<>();

    public Directory(String name, String owner) {
        super(name, owner);
    }

    // Añadir un nodo al directorio
    public boolean addNode(Node node) {

        if (node == null ||
            node.getName().equals(".") ||
            node.getName().equals("..") ||
            nodelist.contains(node)) {
            return false;
        }

        nodelist.add(node);
        return true;
    }

    // Buscar archivos de un propietario en todos los niveles
    public boolean hasOwnerFiles(String owner) {

        for (Node node : nodelist) {

            if (node instanceof File) {

                if (node.getOwner().equals(owner)) {
                    return true;
                }

            } else if (node instanceof Directory) {

                Directory dir = (Directory) node;

                if (dir.hasOwnerFiles(owner)) {
                    return true;
                }
            }
        }

        return false;
    }

    // Comparador por propietario y después por nombre
    private static class OwnerComparation
            implements Comparator<Node> {

        @Override
        public int compare(Node n1, Node n2) {

            int result = n1.getOwner().compareTo(n2.getOwner());

            if (result != 0) {
                return result;
            }

            return n1.getName().compareTo(n2.getName());
        }
    }

    // Devolver los nodos directos ordenados
    public Collection<Node> getNodesByOwnerAndName() {

        List<Node> listordered = new ArrayList<>(nodelist);

        listordered.sort(new OwnerComparation());

        return listordered;
    }

    // Calcular el tamaño total del directorio y su contenido
    @Override
    public int getSize() {

        int size = Tools.nodeSize(this);

        for (Node node : nodelist) {
            size += node.getSize(); //usamos getSize porwue nos dice cual queremos ejeuctar si el de File o el de directory
        }

        return size;
    }
}

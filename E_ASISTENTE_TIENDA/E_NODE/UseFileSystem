import java.util.*;

public class UseFileSystem {

    public static void main(String[] args) {
        probarClaseFile();
        probarAddNode();
        probarHasOwnerFiles();
        probarGetNodesByOwnerAndName();
        probarGetSize();
    }

    private static void probarClaseFile() {
        File f1 = new File("documento.txt", "alice");
        System.out.printf("- toString de File: %s\n", f1);
        System.out.printf("- getSize de File (espero 10): %d\n", f1.getSize());
    }

    private static void probarAddNode() {
        Directory dir = new Directory("MiDir", "bob");
        File f1 = new File("file1.txt", "bob");

        System.out.printf("- añade fichero que no existía: %s\n", dir.addNode(f1));
        System.out.printf("- añade fichero que ya existía (espero false): %s\n", dir.addNode(f1));
        System.out.printf("- añade fichero con nombre inválido '.' (espero false): %s\n", dir.addNode(new File(".", "bob")));
        System.out.printf("- añade fichero con nombre inválido '..' (espero false): %s\n", dir.addNode(new File("..", "bob")));
    }

    private static void probarHasOwnerFiles() {
        Directory dir = new Directory("RootDir", "admin");
        File f1 = new File("file1.txt", "alice");
        File f2 = new File("file2.txt", "bob");
        Directory subDir = new Directory("SubDir", "admin");
        File f3 = new File("file3.txt", "mark");

        subDir.addNode(f3);
        dir.addNode(f1);
        dir.addNode(f2);
        dir.addNode(subDir);

        System.out.printf("- dir tiene archivos de 'alice' (espero true): %s\n", dir.hasOwnerFiles("alice"));
        System.out.printf("- dir tiene archivos de 'mark' (espero true): %s\n", dir.hasOwnerFiles("mark"));
        System.out.printf("- dir tiene archivos de 'admin' (espero false): %s\n", dir.hasOwnerFiles("admin"));
    }

    private static void probarGetNodesByOwnerAndName() {
        Directory dir = new Directory("RootDir", "admin");
        File f1 = new File("fileC.txt", "alice");
        File f2 = new File("fileA.txt", "bob");
        File f3 = new File("fileB.txt", "alice");

        dir.addNode(f1);
        dir.addNode(f2);
        dir.addNode(f3);

        System.out.println("\nNodos ordenados por propietario y nombre:");

        for (Node node : dir.getNodesByOwnerAndName()) {
            System.out.printf("\t - %s\n", node);
        }
    }

    private static void probarGetSize() {
        Directory dir = new Directory("RootDir", "admin");
        File f1 = new File("file1.txt", "alice");
        File f2 = new File("file2.txt", "bob");
        Directory subDir = new Directory("SubDir", "admin");
        File f3 = new File("file3.txt", "mark");

        subDir.addNode(f3);
        dir.addNode(f1);
        dir.addNode(f2);
        dir.addNode(subDir);

        System.out.printf("- Tamaño total del directorio (espero 38): %d\n", dir.getSize());
    }
}

public abstract class Node{
    
    /**
    * Representa un nodo de un sistema de ficheros.
    * Es la clase padre de File y Directory.
    */
    
    private String name;
    private String owner;
    private int id;
    
    /** 
    * Construye un nodo con nombre y propietario.
    * Identificador se genera automáticamente
    * 
    * @param name nombre del nodo
    * @param owner nombre del dueño
    */
    
    public Node(String name, String owner) {
        this.name = name;
        this.owner = owner;
        this.id = Tools.createNodeId();
    }
    
    /**
     * Obtiene identificador del nodo
     * 
     * @return identificador nodo
    */
    
    public int getId() {
        return this.id;
    }
    
     /**
     * Obtiene nombre del nodo
     * 
     * @return nombre nodo
    */
    
    public String getName() {
        return this.name;
    }
    
     /**
     * Obtiene dueño del nodo
     * 
     * @return dueño nodo
    */
    
    public String getOwner() {
        return this.owner;
    }
    
     /**
     * Construye una representacion textual del nodo
     * 
     * @return propietario y nombre del nodo
    */
    
    @Override
    public String toString() {
        return String.format("[%s] - %s", this.owner, this.name);
    }
    
     /**
     * Obtiene tamaño del nodo en kBytes
     * 
     * @return tamaño nodo en kbytes
    */
    
    public abstract int getSize();
    
}

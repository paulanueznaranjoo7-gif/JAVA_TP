

public class Tools {

    private static int nextId = 1;

    // Genera un identificador único para cada nodo
    public static int createNodeId() {
        return nextId++;
    }

    // Devuelve un tamaño de prueba para cada nodo
    public static int nodeSize(Node node) {

        if (node instanceof File) {
            return 10;
        }

        if (node instanceof Directory) {
            return 2;
        }

        return 0;
    }
}

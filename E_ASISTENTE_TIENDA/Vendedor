

package tp.examen;

import java.util.ArrayList;
import java.util.List;
import java.util.Iterator;
import java.util.Comparator;

public class Vendedor extends Persona {

    private List<Cliente> clients = new ArrayList<>();

    public Vendedor(String nameseller, String id) {
        super(nameseller, id);
    }

    public boolean isMember(Persona person) {

        if (person == null || !clients.contains(person)) {
            return false;
        } else {
            return true;
        }
    }

    public boolean add(Persona person) {

        if (!(person instanceof Cliente)) {
            return false;
        }

        Cliente client = (Cliente) person;

        if (isMember(client) || client.seller != null) {
            return false;
        }

        clients.add(client);
        client.seller = this;

        return true;
    }

    public boolean remove(String id) {

        Iterator<Cliente> it = clients.iterator();

        while (it.hasNext()) {

            Cliente client = it.next();

            if (client.getId().equals(id)) {
                it.remove();
                client.seller = null;
                return true;
            }
        }

        return false;
    }

    // Ordena por nombre y después por ID
    private static class ComparadorNombre
            implements Comparator<Persona> {

        @Override
        public int compare(Persona a, Persona b) {

            int resultado = a.getName().compareTo(b.getName());

            if (resultado != 0) {
                return resultado;
            }

            return a.getId().compareTo(b.getId());
        }
    }

    public List<Persona> getClient() {

        List<Persona> resultado = new ArrayList<>(clients);

        resultado.sort(new ComparadorNombre());

        return resultado;
    }

    // Ordena solamente por ID
    private static class ComparadorId
            implements Comparator<Cliente> {

        @Override
        public int compare(Cliente p1, Cliente p2) {
            return p1.getId().compareTo(p2.getId());
        }
    }

    @Override
    public void EstadoActual() {

        List<Cliente> ordenados = new ArrayList<>(clients);

        ordenados.sort(new ComparadorId());

        StringBuilder result = new StringBuilder();

        for (Cliente client : ordenados) {
            result.append(client.toString());
            result.append("\n");
        }

        System.out.print(result.toString());
    }
}

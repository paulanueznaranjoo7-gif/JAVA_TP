public class Consultant extends CompanyUnit{
    
    private int hours;
    
    public Consultant(String name, int id) {
        super(name);
        this.hours = hours;
    }
    
    public int getHours() {
        return this.hours;
    }
    
    @Override
    public String toString(){
        return String.format("%s(Consultor)", super.toString());
    }
    
    @Override
    public int getWeeklyHours(){
        return this.hours;
    }
}
